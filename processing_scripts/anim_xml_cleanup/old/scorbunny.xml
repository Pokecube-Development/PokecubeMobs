<?xml version="1.0" encoding="UTF-8"?>
<ModelAnimator version="0.1">
<model name="">
<!-- Global settings -->
<phase name="global" scale="0.07"/>
<metadata head="head" headCap="-70,70" headCap1="-60,60"/>
<phase name="biWalk" leftLeg="leg1" rightLeg="leg2" leftArm="" rightArm="" duration="10" legAngle="65"/>

<!-- Custom textures -->
<customTex default="scorbunny">
	<part name="Face" tex="scorbunny_face"/>
	<animation diffs="0,0.5" part="Face" trigger="random:0.005:5"/>
</customTex>

<!-- Sitting animation -->
<phase type="sitting">
	<part name="body">
		<component name="1" posOffset="0,16,0" length="1" startKey="0"/>
	</part>
	<part name="leg1">
		<component name="1" rotOffset="-90,70,30" rotChange="0,0,-3" length="8" startKey="0"/>
		<component name="2" rotChange="0,0,3" length="8" startKey="10"/>
	</part>
	<part name="leg2">
		<component name="1" rotOffset="-90,-70,-30" rotChange="0,0,3" length="8" startKey="0"/>
		<component name="2" rotChange="0,0,-3" length="8" startKey="10"/>
	</part>
	<part name="arm1">
		<component name="1" rotOffset="0,0,-50" length="1" startKey="0"/>
	</part>
	<part name="hand1">
		<component name="1" rotOffset="0,0,50" length="1" startKey="0"/>
	</part>
	<part name="arm2">
		<component name="1" rotOffset="0,0,50" length="1" startKey="0"/>
	</part>
	<part name="hand2">
		<component name="1" rotOffset="0,0,-50" length="1" startKey="0"/>
	</part>
	<part name="orl1">
		<component name="1" rotChange="0,0,-2" length="12" startKey="0"/>
		<component name="2" rotChange="0,0,2" length="12" startKey="10"/>
	</part>
	<part name="orl2">
		<component name="1" rotChange="0,0,2" length="12" startKey="0"/>
		<component name="2" rotChange="0,0,-2" length="12" startKey="10"/>
	</part>
</phase>

<!-- Idle animation 1 -->
<phase type="idle1">
	<part name="arm1">
		<component name="1" rotOffset="0,0,-15" length="1" startKey="0"/>
	</part>
	<part name="arm1_1">
		<component name="1" rotOffset="0,0,-20" length="1" startKey="0"/>
	</part>
	<part name="arm2">
		<component name="1" rotOffset="0,0,15" length="1" startKey="0"/>
	</part>
	<part name="arm2_1">
		<component name="1" rotOffset="0,0,20" length="1" startKey="0"/>
	</part>
	<part name="leg1">
		<component name="1" rotOffset="0,0,10" length="1" startKey="0"/>
	</part>
	<part name="foot1">
		<component name="1" rotOffset="0,8,-7" length="1" startKey="0"/>
	</part>
	<part name="leg2">
		<component name="1" rotOffset="0,0,-7" length="1" startKey="0"/>
