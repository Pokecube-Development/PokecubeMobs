	</part>
	<part name="body">
		<component name="1" posOffset="0,-6,0" posChange="0,-8,0" length="5" startKey="0"/>
		<component name="2" posChange="0,8,0" length="5" startKey="5"/>
	</part>
	<part name="leg1">
		<component name="1" rotChange="-5,0,0" length="6" startKey="0"/>
		<component name="2" rotChange="5,0,0" length="6" startKey="10"/>
	</part>
	<part name="foot1">
