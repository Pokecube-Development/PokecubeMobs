		<component name="3" rotChange="25,0,0" length="6" startKey="10"/>
	</part>
	<part name="foot1_1">
		<component name="1" posOffset="1,-1.5,0" rotOffset="-30,0,0" length="1" startKey="0"/>
	</part>
	<part name="foot2_1">
		<component name="1" posOffset="1,-1.5,0" rotOffset="-30,0,0" length="1" startKey="0"/>
	</part>
	<part name="orl1">
		<component name="1" rotChange="0,0,-2" length="12" startKey="0"/>
		<component name="2" rotChange="0,0,2" length="12" startKey="10"/>
