<?xml version="1.0" encoding="utf-8"?>
<ModelAnimator>
 <model>
  <phase name="global" scale="0.09"/>
  <metadata head="head" headCap="-20,20" headCap1="-20,20"/>
  <customTex default="tynamo">
   <part name="Face" tex="tynamo_face"/>
   <animation diffs="0,0.5" part="Face" trigger="random:0.005:5"/>
  </customTex>
  <material name="Glow" light="1" transparece="false" shader="swirl_shader"/>
  <phase axis="0" length="140" angle="15" name="snakeIdle" parts="tail:tail1:tail2:tail3:tail4:tail5:tail6"/>
  <phase axis="2" length="180" angle="15" name="snakeWalk" parts="tail:tail1:tail2:tail3:tail4:tail5:tail6"/>
  <phase axis="0" length="160" angle="10" name="snakeFloating" parts="tail:tail1:tail2:tail3:tail4:tail5:tail6"/>
  <phase type="idle">
   <part name="body">
    <component length="10" name="1" rotChange="0,4,0" startKey="0"/>
	<component length="10" name="2" rotChange="0,-4,0" startKey="10"/>
   </part>
  </phase>
  <phase type="walking">
   <part name="body">
    <component length="10" name="1" rotChange="0,2,0" startKey="0"/>
	<component length="10" name="2" rotChange="0,-4,0" startKey="5"/>
	<component length="10" name="2" rotChange="0,2,0" startKey="10"/>
   </part>
  </phase>
  <phase type="floating">
   <part name="body">
    <component length="8" name="1" rotChange="0,2,0" startKey="0"/>
	<component length="8" name="2" rotChange="0,-4,0" startKey="5"/>
	<component length="8" name="2" rotChange="0,2,0" startKey="10"/>
   </part>
  </phase>
 </model>
</ModelAnimator>