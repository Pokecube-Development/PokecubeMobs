   </part>
   <part name="arm2">
    <component length="10" name="1" rotChange="0,0,-5" startKey="0"/>
    <component length="10" name="2" rotChange="0,0,5" startKey="10"/>
   </part>
   <part name="arm1">
    <component length="10" name="1" rotChange="0,0,5" startKey="0"/>
    <component length="10" name="2" rotChange="0,0,-5" startKey="10"/>
   </part>
  </phase>
  <phase type="walking">
