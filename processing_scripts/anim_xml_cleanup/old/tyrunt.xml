   </part>
   <part name="body">
    <component length="10" name="1" rotOffset="5,0,0" rotChange="4,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="-4,0,0" startKey="10"/>
   </part>
   <part name="mouth">
    <component length="10" name="1" rotOffset="20,0,0" rotChange="5,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="-5,0,0" startKey="10"/>
   </part>
   <part name="arm2">
    <component length="10" name="1" rotChange="0,0,-5" startKey="0"/>
