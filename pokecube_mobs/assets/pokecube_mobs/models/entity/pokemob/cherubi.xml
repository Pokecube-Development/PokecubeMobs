<?xml version="1.0" encoding="utf-8"?>
<ModelAnimator>
 <model>
  <phase name="global" scale="0.1"/>
  <metadata head="body" headCap="-20,20" headCap1="-20,20"/>
  <phase duration="10" leftArm="" leftLeg="foot1" legAngle="25" name="biWalk" rightArm="" rightLeg="foot2"/>
  <customTex default="cherubi">
   <part name="Face" tex="cherubi_face"/>
   <animation diffs="0,0.5" part="Face" trigger="random:0.005:5"/>
   <part name="Head" tex="cherubi_face_extra"/>
   <animation diffs="0,0.5" part="Head" trigger="random:0.005:5"/>
  </customTex>
  <phase type="idle">
   <part name="leaf:arm">
    <component length="10" name="1" rotChange="4,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="-4,0,0" startKey="10"/>
   </part>
   <part name="leaf1:leaf2">
    <component length="10" name="1" rotChange="-8,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="8,0,0" startKey="10"/>
   </part>
   <part name="body">
    <component length="10" name="1" rotChange="-1,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="1,0,0" startKey="10"/>
   </part>
  </phase>
  <phase type="walking">
   <part name="leaf">
    <component length="10" name="1" rotChange="0,-8,0" startKey="0"/>
	<component length="10" name="2" rotChange="0,16,0" startKey="5"/>
    <component length="10" name="3" rotChange="0,-8,0" startKey="10"/>
   </part>
   <part name="arm">
    <component length="10" name="1" rotChange="4,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="-4,0,0" startKey="10"/>
   </part>
   <part name="leaf1:leaf2">
    <component length="10" name="1" rotChange="-8,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="8,0,0" startKey="10"/>
   </part>
   <part name="body">
    <component length="10" name="1" rotChange="-1,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="1,0,0" startKey="10"/>
   </part>
  </phase>
 </model>
</ModelAnimator>