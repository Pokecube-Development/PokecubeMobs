<?xml version="1.0" encoding="utf-8"?>
<ModelAnimator>
 <model>
  <phase name="global" scale="0.12"/>
  <metadata head="head" headCap="-30,30" headCap1="-30,30"/>
  <phase duration="10" leftArm="" leftLeg="leg1:foot1" legAngle="25" name="biWalk" rightArm="" rightLeg="leg2:foot2"/>
  <phase female="f" male="m" name="textures"/>
  <customTex default="torchic">
   <part name="Eye" tex="torchic_eye"/>
   <animation diffs="0,0.5" part="Eye" trigger="random:0.005:5"/>
  </customTex>
  <phase type="sitting">
   <part name="top">
    <component length="10" name="1" rotChange="-4,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="4,0,0" startKey="10"/>
   </part>
   <part name="mouth">
    <component length="10" name="1" rotChange="-4,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="4,0,0" startKey="10"/>
   </part>
   <part name="leg1">
    <component length="10" name="1" hidden="true" startKey="0"/>
   </part>
   <part name="leg2">
    <component length="10" name="1" hidden="true" startKey="0"/>
   </part>
   <part name="body">
    <component length="10" name="1" posOffset="0,10,0" startKey="0"/>
   </part>
  </phase>
  <phase type="idle">
   <part name="top">
    <component length="10" name="1" rotChange="-2,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="2,0,0" startKey="10"/>
   </part>
   <part name="mouth">
    <component length="10" name="1" rotChange="-4,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="4,0,0" startKey="10"/>
   </part>
   <part name="leg1">
    <component length="10" name="1" rotOffset="0,18,0" startKey="0"/>
   </part>
   <part name="leg2">
    <component length="10" name="1" rotOffset="0,-18,0" startKey="0"/>
   </part>
   <part name="body">
    <component length="10" name="1" rotChange="-1,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="1,0,0" startKey="10"/>
   </part>
  </phase>
  <phase type="walking">
   <part name="top">
    <component length="10" name="1" rotChange="-8,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="8,0,0" startKey="10"/>
   </part>
   <part name="mouth">
    <component length="10" name="1" rotChange="-4,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="4,0,0" startKey="10"/>
   </part>
   <part name="body">
    <component length="10" name="1" rotChange="-1,0,0" startKey="0"/>
    <component length="10" name="2" rotChange="1,0,0" startKey="10"/>
   </part>
  </phase>
 </model>
</ModelAnimator>